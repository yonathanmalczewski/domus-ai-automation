    {
      "parameters": {
        "jsCode": "// Manejador global: captura cualquier falla no controlada de los flujos que lo tengan como Error Workflow.\nconst cfg = $('Config').first().json;\nconst e = $('Trigger · Error en cualquier flujo').first().json;\nconst nodo = e.execution?.lastNodeExecuted || 'desconocido';\nconst detalle = String(e.execution?.error?.message || 'Sin mensaje').slice(0, 1800);\nconst execId = String(e.execution?.id ?? 'sin-id');\nreturn [{ json: {\n  nodo, detalle, execId,\n  workflow: e.workflow?.name || 'desconocido',\n  url: e.execution?.url || '',\n  body_log: { parent: { database_id: cfg.notion_db_log }, properties: {\n    'Evento': { title: [{ text: { content: `Error no controlado en \"${nodo}\"` } }] },\n    'Tipo': { select: { name: 'Error no controlado' } },\n    'Workflow': { select: { name: 'WF99 Errores' } },\n    'Nodo': { rich_text: [{ text: { content: nodo } }] },\n    'Detalle': { rich_text: [{ text: { content: `[${e.workflow?.name || ''}] ${detalle}` } }] },\n    'ID ejecucion': { rich_text: [{ text: { content: execId } }] },\n    'Fecha': { date: { start: new Date().toISOString() } },\n  } },\n} }];\n"
      },
      "id": "5d1abca7-10a1-4f95-9a76-3c1251514320",
      "name": "Error · Formatear incidente",
